# {{ ansible_managed }}
# fail2ban jail configuration

[DEFAULT]
bantime  = {{ hardening_fail2ban_bantime }}
findtime = {{ hardening_fail2ban_findtime }}
maxretry = {{ hardening_fail2ban_maxretry }}
banaction = nftables-multiport
backend  = systemd

[sshd]
enabled  = true
port     = {{ hardening_ssh_port }}
filter   = sshd
logpath  = %(sshd_log)s
maxretry = {{ hardening_fail2ban_maxretry }}
