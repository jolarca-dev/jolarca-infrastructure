#!/bin/bash
# {{ ansible_managed }}
# Backup staleness monitor — alerts if no successful backup in {{ backup_staleness_hours }}h.
set -euo pipefail

STATUS_FILE="/var/backups/last-backup-status"
STALENESS_HOURS={{ backup_staleness_hours }}
LOG_FILE="{{ backup_log_file }}"

if [ ! -f "${STATUS_FILE}" ]; then
  echo "[$(date)] ⚠️ ALERT: No backup status file found — no backup has ever run"
  exit 1
fi

LAST_BACKUP_TIME=$(head -1 "${STATUS_FILE}" | cut -d' ' -f1)
LAST_BACKUP_RESULT=$(head -1 "${STATUS_FILE}" | cut -d' ' -f2)

# Calculate hours since last backup
LAST_EPOCH=$(date -d "${LAST_BACKUP_TIME}" +%s 2>/dev/null || echo 0)
NOW_EPOCH=$(date +%s)
HOURS_AGO=$(( (NOW_EPOCH - LAST_EPOCH) / 3600 ))

if [ "${LAST_BACKUP_RESULT}" != "0" ]; then
  echo "[$(date)] ❌ ALERT: Last backup FAILED (exit code: ${LAST_BACKUP_RESULT}, ${HOURS_AGO}h ago)"
  exit 1
fi

if [ "${HOURS_AGO}" -gt "${STALENESS_HOURS}" ]; then
  echo "[$(date)] ❌ ALERT: No successful backup in ${HOURS_AGO}h (threshold: ${STALENESS_HOURS}h)"
  exit 1
fi

echo "[$(date)] ✅ Backup OK — last successful backup ${HOURS_AGO}h ago"
exit 0
