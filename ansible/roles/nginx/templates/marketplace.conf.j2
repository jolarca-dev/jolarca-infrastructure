# {{ ansible_managed }}
# Marketplace edge proxy — hardened TLS + WAF + structured logging.
# Staging: self-signed cert. Production: Let's Encrypt via dehydrated.

# ── Rate limiting zones ──────────────────────────────────────────────
limit_req_zone $binary_remote_addr zone=auth_limit:10m rate=5r/m;
limit_req_zone $binary_remote_addr zone=api_limit:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=registration_limit:10m rate=2r/m;

# ── Upstream definitions ─────────────────────────────────────────────
upstream django_backend {
    server {{ backend_upstream | default('10.10.1.2:8000') }};
    keepalive 32;
}

upstream nextjs_frontend {
    server {{ frontend_upstream | default('10.10.1.2:3000') }};
    keepalive 32;
}

# ── JSON access log format (structured for log aggregation) ──────────
log_format json_combined escape=json
  '{'
    '"time":"$time_iso8601",'
    '"remote_addr":"$remote_addr",'
    '"request":"$request",'
    '"status":$status,'
    '"body_bytes_sent":$body_bytes_sent,'
    '"http_referer":"$http_referer",'
    '"http_user_agent":"$http_user_agent",'
    '"request_time":$request_time,'
    '"upstream_response_time":"$upstream_response_time",'
    '"request_length":$request_length,'
    '"http_x_forwarded_for":"$http_x_forwarded_for",'
    '"ssl_protocol":"$ssl_protocol",'
    '"ssl_cipher":"$ssl_cipher"'
  '}';

# ── HTTP → HTTPS redirect ────────────────────────────────────────────
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;

    # Allow ACME challenge for Let's Encrypt
    location /.well-known/acme-challenge/ {
        root /var/www/dehydrated;
        allow all;
    }

    # Redirect everything else to HTTPS
    location / {
        return 301 https://$host$request_uri;
    }
}

# ── HTTPS server (hardened) ──────────────────────────────────────────
server {
    listen 443 ssl http2 default_server;
    listen [::]:443 ssl http2 default_server;
    server_name {{ nginx_server_name | default('_') }};

    # ── TLS configuration ────────────────────────────────────────────
    ssl_certificate {{ nginx_tls_cert | default('/etc/ssl/certs/ssl-cert-snakeoil.pem') }};
    ssl_certificate_key {{ nginx_tls_key | default('/etc/ssl/private/ssl-cert-snakeoil.key') }};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    ssl_stapling on;
    ssl_stapling_verify on;
    ssl_early_data off;

    # ── Security headers ─────────────────────────────────────────────
    include /etc/nginx/conf.d/security_headers.conf;

    # ── WAF rules ────────────────────────────────────────────────────
    include /etc/nginx/conf.d/waf_rules.conf;

    # Block path traversal
    if ($block_path_traversal) {
        return 403;
    }

    # Block SQL injection probes
    if ($block_sqli) {
        return 403;
    }

    # Block bad user-agents
    if ($block_bad_ua) {
        return 403;
    }

    # ── Rate limiting ────────────────────────────────────────────────
    limit_req zone=api_limit burst={{ nginx_rate_limit_burst | default(50) }} nodelay;
    limit_conn conn_limit 20;

    # ── Request size limits ──────────────────────────────────────────
    client_max_body_size {{ nginx_max_body_size | default('10m') }};
    client_body_timeout {{ nginx_client_body_timeout | default('30s') }};
    client_header_timeout 15s;

    # ── Structured JSON access logging ───────────────────────────────
    access_log /var/log/nginx/access.log json_combined;

    # ── Health check (no rate limit, no auth, no logging) ────────────
    location /health {
        access_log off;
        return 200 '{"status":"ok","service":"edge"}';
        add_header Content-Type application/json;
    }

    # ── Django API ───────────────────────────────────────────────────
    location /api/ {
        proxy_pass http://django_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout {{ nginx_proxy_read_timeout | default('60s') }};
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_buffering on;
        proxy_buffer_size 8k;
        proxy_buffers 16 8k;
    }

    # ── Auth endpoints (strict rate limit) ───────────────────────────
    location ~ ^/api/v1/auth/ {
        limit_req zone=auth_limit burst=3 nodelay;
        proxy_pass http://django_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_connect_timeout 10s;
    }

    # ── Registration endpoint (strict rate limit) ────────────────────
    location ~ ^/api/v1/register {
        limit_req zone=registration_limit burst=2 nodelay;
        proxy_pass http://django_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_connect_timeout 10s;
    }

    # ── Django admin (rate-limited) ──────────────────────────────────
    location /admin/ {
        limit_req zone=auth_limit burst=3 nodelay;
        proxy_pass http://django_backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
        proxy_connect_timeout 10s;
    }

    # ── Django static files ──────────────────────────────────────────
    location /static/ {
        proxy_pass http://django_backend;
        proxy_set_header Host $host;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # ── Django media files ───────────────────────────────────────────
    location /media/ {
        proxy_pass http://django_backend;
        proxy_set_header Host $host;
        expires 7d;
    }

    # ── Next.js frontend (catch-all) ─────────────────────────────────
    location / {
        proxy_pass http://nextjs_frontend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout {{ nginx_proxy_read_timeout | default('60s') }};
        proxy_connect_timeout 10s;
        proxy_buffering on;
        proxy_buffer_size 8k;
        proxy_buffers 16 8k;
    }

    # ── Deny access to hidden files ──────────────────────────────────
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
