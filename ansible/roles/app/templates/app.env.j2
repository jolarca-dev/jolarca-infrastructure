# {{ ansible_managed }}
# Django environment — secrets from Vault, no plaintext.
# This file is mode 0640, owned by jol:jol.

DJANGO_SETTINGS_MODULE={{ django_settings_module }}
DJANGO_ENV={{ app_env }}
DJANGO_SECRET_KEY={{ vault_django_secret_key | default('CHANGE_ME_FROM_VAULT') }}
DJANGO_ALLOWED_HOSTS={{ django_allowed_hosts | join(',') }}
DJANGO_DEBUG=false

# Database (TLS-only)
DATABASE_URL=postgres://{{ db_user }}:{{ vault_pg_app_password | default('CHANGE_ME_FROM_VAULT') }}@{{ db_host }}:{{ db_port }}/{{ db_name }}?sslmode=verify-full

# MinIO / S3
MINIO_ENDPOINT={{ minio_endpoint }}
MINIO_ACCESS_KEY={{ vault_minio_root_user | default('minioadmin') }}
MINIO_SECRET_KEY={{ vault_minio_root_password | default('minioadmin') }}
MINIO_MEDIA_BUCKET={{ minio_media_bucket }}
MINIO_UPLOADS_BUCKET={{ minio_uploads_bucket }}
MINIO_REGION={{ minio_region | default('eu-central-1') }}

# Vault (runtime secret fetching)
VAULT_ADDR={{ vault_addr }}
VAULT_ROLE={{ vault_role }}

# Stripe (test mode for staging)
STRIPE_SECRET_KEY={{ vault_stripe_secret_key | default('sk_test_CHANGE_ME') }}
STRIPE_WEBHOOK_SECRET={{ vault_stripe_webhook_secret | default('whsec_CHANGE_ME') }}

# Redis (Celery broker + Django cache)
REDIS_URL={{ vault_redis_url | default('redis://:' + (vault_redis_password | default('CHANGE_ME_FROM_VAULT')) + '@10.10.1.2:6379/0') }}

# Celery
CELERY_BROKER_URL={{ vault_redis_url | default('redis://:' + (vault_redis_password | default('CHANGE_ME_FROM_VAULT')) + '@10.10.1.2:6379/0') }}
CELERY_RESULT_BACKEND={{ vault_redis_url | default('redis://:' + (vault_redis_password | default('CHANGE_ME_FROM_VAULT')) + '@10.10.1.2:6379/1') }}

# Frontend
NEXT_PUBLIC_API_URL=http://127.0.0.1:{{ django_port }}
