# .gitignore — paranoid baseline.
# RULE: state, keys, and vault password files MUST NEVER appear in git.
# Enforced here, by gitleaks (pre-commit + CI), and scripts/audit-no-secrets.sh.

# ── Terraform ─────────────────────────────────────────────────────────────
# Local state is the crown jewel: contains full resource metadata.
*.tfstate
*.tfstate.*
*.tfplan
# Migration-window backend overlay (ADR-0003 runbook) — never committed:
terraform/environments/**/zz-remote-backend.tmp.tf
plan.out
**/.terraform/*
**/.terraform.lock.hcl.bak
crash.log
crash.*.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Local operator overrides of backend config (may contain paths/creds)
terraform/backends/*.local.hcl
# Provider credentials files
*.tfrc
credentials.tfrc.json
# terraform.tfvars may contain credentials — never commit.
# Only *.tfvars.example (placeholders) is tracked.
*.tfvars
!*.tfvars.example

# ── Secrets & key material ────────────────────────────────────────────────
*.pem
*.key
*.p12
*.pfx
*.jks
*.gpg
*.agekey
*.pubkey-private*
id_rsa*
id_ed25519*
# Vault password files (ansible-vault dual control)
.vault-pass*
*-vault-pass*
vault_pass*

# ── Environment & credential files ────────────────────────────────────────
.env
.env.*
!.envrc.example
.envrc

# ── Ansible ───────────────────────────────────────────────────────────────
*.retry
ansible/inventories/**/artifacts/

# ── Editors / OS ──────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
.DS_Store

# ── Python virtual environments (tooling harness only — no runtime code) ──
.venv/
venv/
tfplan-staging-bootstrap
ansible/.ansible/
