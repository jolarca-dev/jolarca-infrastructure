# DISABLED 2026-08 (renamed from codeql.yml): CodeQL code scanning requires
# GitHub Advanced Security, which is not part of the current plan for
# private repositories (upload fails: "Code Security must be enabled").
# Static analysis of the pipeline is currently covered by: yamllint +
# shellcheck + action pin review + gitleaks. Re-enable by restoring this
# file to codeql.yml IF GitHub Advanced Security is purchased.
#
# codeql.yml — inherited baseline: static analysis over pipeline definitions.
# This repo has no application code; CodeQL analyzes the GitHub Actions
# workflows themselves (workflow injection is a real infra supply-chain risk).
name: codeql
on:
  pull_request:
  push:
    branches: [main]
  schedule:
    - cron: "31 4 * * 1"   # weekly Monday scan
permissions:
  contents: read
jobs:
  analyze:
    runs-on: ubuntu-latest
    permissions:
      contents: read        # checkout needs this even at job scope
      actions: read         # CodeQL actions-language analysis reads run data
      security-events: write
    steps:
      - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683 # v4.2.2

      - name: Initialize CodeQL
        uses: github/codeql-action/init@v3
        with:
          languages: actions

      - name: Perform CodeQL Analysis
        uses: github/codeql-action/analyze@v3
